{
  "name": "simple-job-scheduler",
  "version": "1.1.2",
  "description": "A simple job scheduling system written in TypeScript",
  "author": "Aurélien Manteaux <amanteaux@coreoz.com> (https://coreoz.com)",
  "repository": "https://github.com/coreoz/simple-job-scheduler",
  "homepage": "https://github.com/coreoz/simple-job-scheduler",
  "license": "Apache-2.0",
  "keywords": [
    "scheduler",
    "periodic-tasks",
    "periodic-jobs",
    "job-scheduler"
  ],
  "scripts": {
    "build": "yarn build:cjs && yarn build:esm && yarn build:types",
    "build:cjs": "swc src --config-file .swcrc -C module.type=commonjs --out-dir build/cjs --strip-leading-paths --ignore \"**/tests/**\"",
    "build:esm": "swc src --config-file .swcrc -C module.type=es6 --out-dir build/esm --strip-leading-paths --ignore \"**/tests/**\"",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit -p tsconfig.json && eslint src --ext .ts",
    "test": "vitest run",
    "test:build": "vitest run --config vitest.build.config.mts",
    "prepare-release": "yarn clean && yarn lint && yarn test && yarn build && yarn test:build",
    "release": "release-it"
  },
  "release-it": {
    "hooks": {
      "before:init": [
        "yarn prepare-release"
      ]
    }
  },
  "main": "build/cjs/index.js",
  "typings": "build/esm/index.d.ts",
  "module": "build/esm/index.js",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.12.0",
  "dependencies": {
    "simple-logging-system": "^1.0.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^4.2.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.2",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-import": "^2.31.0",
    "plume-ts-di": "^1.2.4",
    "release-it": "^19.2.4",
    "swc-class-decorator-plugin": "^1.2.0",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "files": [
    "build/**/*.*"
  ]
}
