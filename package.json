{
  "name": "simple-job-scheduler",
  "version": "1.1.2",
  "description": "A simple job scheduling system written in TypeScript",
  "author": "Aurélien Manteaux <amanteaux@coreoz.com> (https://coreoz.com)",
  "repository": "https://github.com/coreoz/simple-job-scheduler",
  "homepage": "https://github.com/coreoz/simple-job-scheduler",
  "license": "Apache-2.0",
  "keywords": [
    "scheduler",
    "periodic-tasks",
    "periodic-jobs",
    "job-scheduler"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "swc src --config-file .swcrc -C module.type=commonjs --out-dir build/cjs --strip-leading-paths --ignore \"**/tests/**\"",
    "build:esm": "swc src --config-file .swcrc -C module.type=es6 --out-dir build/esm --strip-leading-paths --ignore \"**/tests/**\"",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit -p tsconfig.json && eslint src --ext .ts",
    "test": "mocha -r ts-node/register 'src/tests/**/*.ts'",
    "test:build": "mocha 'tests/package/**/*.cjs'",
    "prepare-release": "npm run clean && npm run lint && npm run test && npm run build && npm run test:build",
    "release": "release-it"
  },
  "release-it": {
    "hooks": {
      "before:init": [
        "npm run prepare-release"
      ]
    }
  },
  "main": "build/cjs/index.js",
  "typings": "build/esm/index.d.ts",
  "module": "build/esm/index.js",
  "engines": {
    "node": ">=10"
  },
  "dependencies": {
    "simple-logging-system": "^1.0.0"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@types/chai": "^4.2.14",
    "@types/mocha": "^8.2.0",
    "@typescript-eslint/eslint-plugin": "^4.0.1",
    "@typescript-eslint/parser": "^4.0.1",
    "chai": "^4.2.0",
    "eslint": "^7.8.0",
    "eslint-config-airbnb-typescript": "^12.0.0",
    "eslint-plugin-import": "^2.22.0",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-react": "^7.21.5",
    "mocha": "^8.2.1",
    "plume-ts-di": "^1.2.4",
    "release-it": "^14.2.2",
    "swc-class-decorator-plugin": "^1.2.0",
    "ts-node": "^9.0.0",
    "typedoc": "^0.19.0",
    "typescript": "^4.0.2"
  },
  "files": [
    "build/**/*.*"
  ],
  "mocha": "mocha src/tests/ --compilers ts:ts-node/register --recursive"
}
